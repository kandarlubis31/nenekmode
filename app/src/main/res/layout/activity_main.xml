<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/baachan_bg">

    <TextView
        android:id="@+id/assistantGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/baachan_primary_dark"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Kartu status besar: warna berubah sesuai state (dengar/berpikir/ngomong) -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_status_pill"
        android:padding="18dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/micIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👋"
            android:textSize="40sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Siap"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/statusSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#ECEFF1"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Riwayat obrolan sebagai bubble chat -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_history">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>

    <TextView
        android:id="@+id/checkInStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cek harian: Aktif"
        android:textSize="13sp"
        android:textColor="@color/gray"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnHealth"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Kesehatan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/baachan_primary"
            android:elevation="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnWeather"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Cuaca"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/baachan_accent"
            android:elevation="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnCompanion"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Mode Teman: OFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/baachan_accent"
            android:elevation="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnBoard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Papan Info"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/baachan_primary"
            android:elevation="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Pengaturan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/baachan_primary"
            android:elevation="4dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Tombol darurat di zona jempol (paling bawah), paling gampang dijangkau -->
    <Button
        android:id="@+id/emergencyButton"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:text="PANGGILAN DARURAT"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/baachan_emergency"
        android:elevation="8dp" />

</LinearLayout>
