<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:background="@color/baachan_bg">

    <TextView
        android:id="@+id/boardClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="96sp"
        android:textStyle="bold"
        android:textColor="@color/baachan_primary_dark"
        android:fontFamily="sans-serif-light"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/boardDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textColor="@color/baachan_primary"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_background"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/boardNextPrayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/baachan_primary_dark"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/boardNextMed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/baachan_primary_dark" />
    </LinearLayout>

    <TextView
        android:id="@+id/boardWeather"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/baachan_primary_dark"
        android:background="@drawable/rounded_background_info"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/boardCompanion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/baachan_primary_dark"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/boardBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/gray"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/boardHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sentuh teks ini untuk kembali ke aplikasi"
        android:textSize="14sp"
        android:textColor="@color/gray"
        android:gravity="center"
        android:padding="12dp" />

</LinearLayout>
